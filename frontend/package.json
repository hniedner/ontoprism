{
	"name": "frontend",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"fallow": "node scripts/fallow-gate.mjs",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:coverage": "vitest run --coverage && cd .. && pdm run coverage-gate frontend --coverage-summary frontend/coverage/coverage-summary.json",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26",
		"@vitest/coverage-v8": "^5.0.3",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"fallow": "2.104.0",
		"globals": "^17.13.0",
		"graphology-types": "^0.24.8",
		"jsdom": "^30.1.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@sigma/edge-curve": "^3.1.0",
		"@sigma/export-image": "^3.0.0",
		"clsx": "^2.1.1",
		"graphology": "^0.26.0",
		"graphology-communities-louvain": "^2.0.2",
		"graphology-layout-forceatlas2": "^0.10.1",
		"graphology-layout-noverlap": "^0.4.2",
		"graphology-metrics": "^2.4.2",
		"sigma": "^3.0.3",
		"tailwind-merge": "^3.7.0"
	},
	"overrides": {
		"brace-expansion": "^5.0.12",
		"nanoid": "^3.3.18"
	},
	"allowScripts": {
		"fsevents": false
	}
}
